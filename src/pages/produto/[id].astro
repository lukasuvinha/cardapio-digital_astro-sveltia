---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { getProdutos, getCoresCategorias, productHasPhoto } from '../../data/menu';
import { SITE_NAME } from '../../config/site';

// Gera uma pagina estatica para cada produto (site 100% estatico).
// Le da Content Collection "produtos". E o destino dos links dos cards (sem
// JS, ou abrindo em nova aba) e dos links compartilhados; no cardapio, com JS,
// o mesmo conteudo abre numa sheet/dialog (ProductSheet.astro).
export async function getStaticPaths() {
  const produtos = await getProdutos();
  const cores = await getCoresCategorias(produtos);
  return produtos.map((product) => ({
    params: { id: product.id },
    props: { product, cor: cores[product.categoria] ?? 'neutro' },
  }));
}

const { product, cor } = Astro.props;
// so deixa ampliar/abrir a foto quando existe uma foto de verdade (nao no
// placeholder "Foto em breve").
const temFoto = productHasPhoto(product);
---

<BaseLayout
  title={`${product.nome} · ${SITE_NAME}`}
  description={product.descricao ?? product.nome}
>
  <Header />

  <main class="cd-detail">
    <a class="cd-detail__back" href="/">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      Voltar ao cardápio
    </a>

    <!-- mesmo visual da sheet/dialog do cardapio: fundo na cor da categoria -->
    <div class="cd-detail__panel" data-cor={cor}>
      <ProductDetail product={product} zoom={temFoto} />
    </div>
  </main>

  {
    temFoto && (
      <div class="cd-lightbox" data-lightbox>
        <div class="cd-lightbox__scrim" data-modal-close />
        <div class="cd-lightbox__panel" role="dialog" aria-modal="true" aria-label={`Foto de ${product.nome}`} data-lightbox-panel>
          <button class="cd-lightbox__close cd-state" type="button" data-modal-close aria-label="Fechar imagem">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
          <img class="cd-lightbox__img" src={product.foto} alt={`Foto de ${product.nome}`} data-modal-close />
        </div>
      </div>
    )
  }

  <Footer />

  <CartDrawer />
</BaseLayout>

<script>
  import { ligarDetalhe } from '../../lib/product-detail';
  import { createModal } from '../../lib/modal';

  // stepper + "Adicionar · R$ X" (mesmo comportamento da sheet do cardapio)
  ligarDetalhe(document);

  // ---- Lightbox da foto (ampliar) ----
  const zoomBtn = document.querySelector<HTMLElement>('[data-zoom]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const panel = lightbox?.querySelector<HTMLElement>('[data-lightbox-panel]');
  if (zoomBtn && lightbox && panel) {
    const modal = createModal(lightbox, {
      panel,
      initialFocus: () => panel.querySelector<HTMLElement>('.cd-lightbox__close'),
    });
    zoomBtn.addEventListener('click', () => modal.open(zoomBtn));
  }
</script>

<style>
  .cd-detail {
    max-width: 1040px;
    margin: 0 auto;
    padding: 12px 16px 120px;
  }
  .cd-detail__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--touch);
    margin: 0 0 8px -6px;
    padding: 0 12px 0 6px;
    border-radius: var(--r-pill);
    color: var(--on-sf);
    font-weight: var(--fw-label);
  }
  .cd-detail__panel {
    padding: 16px 16px 24px;
    border-radius: var(--r-sheet);
    background: var(--cat);
  }

  @media (min-width: 768px) {
    .cd-detail {
      padding: 24px 32px 120px;
    }
    .cd-detail__panel {
      padding: 28px;
    }
  }

  /* Lightbox: foto ampliada em tela cheia */
  .cd-lightbox {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    visibility: hidden;
    transition: visibility 0s linear var(--dur-out);
  }
  .cd-lightbox[data-open='true'] {
    visibility: visible;
    transition: none;
  }
  .cd-lightbox__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
    opacity: 0;
    transition: opacity var(--dur-out) var(--ease-out);
  }
  .cd-lightbox__panel {
    position: relative;
    opacity: 0;
    transform: scale(calc(1 - 0.06 * var(--motion-shift)));
    transition:
      opacity var(--dur-out) var(--ease-out),
      transform var(--dur-out) var(--ease-out);
  }
  .cd-lightbox[data-open='true'] .cd-lightbox__scrim,
  .cd-lightbox[data-open='true'] .cd-lightbox__panel {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-in) var(--ease-in),
      transform var(--dur-in) var(--ease-in);
  }
  .cd-lightbox__panel:focus {
    outline: none;
  }
  /* so durante abrir/fechar (data-animating, colocado por src/lib/modal.ts) */
  .cd-lightbox[data-animating] .cd-lightbox__panel {
    will-change: transform;
  }
  .cd-lightbox[data-animating] .cd-lightbox__scrim {
    will-change: opacity;
  }
  .cd-lightbox__img {
    max-width: min(92vw, 900px);
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-sheet);
    box-shadow: var(--elev-3);
    cursor: zoom-out;
  }
  .cd-lightbox__close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: var(--r-round);
    background: var(--inv-sf);
    color: var(--inv-on-sf);
  }
</style>
