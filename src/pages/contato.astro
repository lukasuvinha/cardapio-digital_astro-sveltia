---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ContactButton from '../components/ContactButton.astro';
import { WHATSAPP_NUMBER, INSTAGRAM_URL, SITE_NAME } from '../config/site';

// Pagina "Contato" (estatica), estilo "linktree" simples: um botao para o
// WhatsApp e outro para o Instagram da loja. O link discreto "Desenvolvedor"
// no fim leva para /desenvolvedor. Como trocar o numero/link: ver
// docs/PAGINAS-INSTITUCIONAIS.md.
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<BaseLayout
  title={`Contato · ${SITE_NAME}`}
  description={`Fale com a ${SITE_NAME} pelo WhatsApp ou Instagram.`}
>
  <Header />

  <main class="cd-contato">
    <div class="cd-contato__rule"></div>
    <span class="cd-contato__eyebrow">Fale com a gente</span>
    <h1 class="cd-contato__title">Contato</h1>
    <p class="cd-contato__text">
      Escolha por onde prefere falar com a gente.
    </p>

    <div class="cd-contato__links">
      <ContactButton href={whatsappUrl} label="WhatsApp" icon="whatsapp" external />
      <ContactButton href={INSTAGRAM_URL} label="Instagram" icon="instagram" external />
    </div>

    <a class="cd-contato__dev" href="/desenvolvedor">Desenvolvedor</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-contato {
    max-width: 460px;
    margin: 0 auto;
    padding: clamp(40px, 10vh, 90px) clamp(20px, 6vw, 32px) 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cd-contato__rule {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 18px;
  }
  .cd-contato__eyebrow {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cd-contato__title {
    margin: 10px 0 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(26px, 6vw, 36px);
    line-height: 1.2;
    color: var(--ink);
  }
  .cd-contato__text {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted-text);
  }
  .cd-contato__links {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 34px;
  }
  .cd-contato__dev {
    margin-top: 46px;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
    opacity: 0.75;
  }
  @media (hover: hover) {
    .cd-contato__dev:hover {
      color: var(--ink);
      opacity: 1;
    }
  }
</style>
