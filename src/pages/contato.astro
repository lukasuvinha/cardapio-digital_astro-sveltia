---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ContactButton from '../components/ContactButton.astro';
import PageHero from '../components/PageHero.astro';
import { WHATSAPP_NUMBER, INSTAGRAM_URL, SITE_NAME } from '../config/site';

// Pagina "Contato" (estatica), estilo "linktree" simples: um botao para o
// WhatsApp e outro para o Instagram da loja. O link discreto "Desenvolvedor"
// no fim leva para /desenvolvedor. Como trocar o numero/link: ver
// docs/PAGINAS-INSTITUCIONAIS.md.
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<BaseLayout
  title={`Contato · ${SITE_NAME}`}
  description={`Fale com a ${SITE_NAME} pelo WhatsApp ou Instagram.`}
>
  <Header />

  <PageHero eyebrow="Fale com a gente" title="Contato" subtitle="Escolha por onde prefere falar com a gente." />

  <main class="cd-page cd-contato">
    <div class="cd-contato__links">
      <ContactButton href={whatsappUrl} label="WhatsApp" icon="whatsapp" external />
      <ContactButton href={INSTAGRAM_URL} label="Instagram" icon="instagram" external />
    </div>

    <a class="cd-contato__dev" href="/desenvolvedor">Desenvolvedor</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-contato__links {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cd-contato__dev {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 12px;
    font-size: var(--fs-label);
    color: var(--on-sf-v);
  }
</style>
