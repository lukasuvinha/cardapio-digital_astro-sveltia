---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_NAME, SITE_LOGO } from '../config/site';

// Pagina 404 (estatica). O Cloudflare a serve quando a rota nao existe
// (ver wrangler.jsonc -> assets.not_found_handling: "404-page").
---

<BaseLayout title={`Página não encontrada · ${SITE_NAME}`}>
  <Header />

  <PageHero eyebrow="Erro 404" title="Essa página saiu do forno" />

  <main class="cd-page cd-404">
    <div class="cd-404__ring">
      <img
        class="cd-404__ring-img"
        src={SITE_LOGO}
        alt={SITE_NAME}
        width="112"
        height="112"
      />
    </div>
    <p class="cd-404__text">
      Não encontramos o que você procurava — mas o cardápio continua quentinho. 💛
    </p>
    <a class="cd-btn cd-btn--cta" href="/">Voltar ao Cardápio</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-404 {
    text-align: center;
  }
  /* Selo com o logo da loja (SITE_LOGO), recortado em circulo. Ver docs/LOGO.md. */
  .cd-404__ring {
    width: 112px;
    height: 112px;
    border-radius: var(--r-round);
    overflow: hidden;
    box-shadow: var(--elev-2);
  }
  .cd-404__ring-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cd-404__text {
    margin: 0;
    max-width: 36ch;
    font-size: 16px;
    color: var(--on-sf-v);
  }
  /* ---- ANTES: monograma de texto no lugar do logo (substituido pela imagem).
     Markup antigo: <div class="cd-404__ring-inner">Nome<br />da Loja</div> */
</style>
