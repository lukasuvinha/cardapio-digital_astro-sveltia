---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

// Pagina 404 (estatica). O Cloudflare a serve quando a rota nao existe
// (ver wrangler.jsonc -> assets.not_found_handling: "404-page").
---

<BaseLayout title="Página não encontrada · Doçuras da Nina">
  <Header />

  <main class="dn-404">
    <div class="dn-404__ring">
      <img
        class="dn-404__ring-img"
        src="/logo-medalhao.png"
        alt="Doçuras da Nina"
        width="112"
        height="112"
      />
    </div>
    <div class="dn-404__code">404</div>
    <h1 class="dn-404__title">Essa página saiu do forno</h1>
    <p class="dn-404__text">
      Não encontramos o que você procurava — mas o cardápio continua quentinho. 💛
    </p>
    <a class="dn-404__btn" href="/">Voltar ao Cardápio</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .dn-404 {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(48px, 12vh, 110px) clamp(20px, 6vw, 32px) 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Medalhao: logo oficial (ver docs/LOGO.md para o porque do verde fixo). */
  .dn-404__ring {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
    box-shadow: 0 4px 16px rgba(198, 161, 91, 0.35);
  }
  .dn-404__ring-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  /* ---- ANTES: monograma de texto no lugar do logo oficial (substituido).
     Markup antigo: <div class="dn-404__ring-inner">Doçuras<br />da Nina</div>
  .dn-404__ring-inner {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-size: 13px;
    color: var(--ink);
    line-height: 1.3;
  }
  */
  .dn-404__code {
    font-family: var(--font-head);
    font-size: 15px;
    letter-spacing: 6px;
    color: var(--gold-text);
  }
  .dn-404__title {
    margin: 10px 0 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(24px, 6vw, 34px);
    line-height: 1.2;
    color: var(--ink);
  }
  .dn-404__text {
    margin: 14px 0 30px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted-text);
    max-width: 40ch;
  }
  .dn-404__btn {
    padding: 15px 30px;
    background: var(--brand);
    color: var(--cream);
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .dn-404__btn:hover {
      color: var(--cream);
      background: #1a4231;
    }
  }
  .dn-404__btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
</style>
