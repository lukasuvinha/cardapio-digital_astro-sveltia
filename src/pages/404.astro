---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { SITE_NAME, SITE_LOGO } from '../config/site';

// Pagina 404 (estatica). O Cloudflare a serve quando a rota nao existe
// (ver wrangler.jsonc -> assets.not_found_handling: "404-page").
---

<BaseLayout title={`Página não encontrada · ${SITE_NAME}`}>
  <Header />

  <main class="cd-404">
    <div class="cd-404__ring">
      <img
        class="cd-404__ring-img"
        src={SITE_LOGO}
        alt={SITE_NAME}
        width="112"
        height="112"
      />
    </div>
    <div class="cd-404__code">404</div>
    <h1 class="cd-404__title">Essa página saiu do forno</h1>
    <p class="cd-404__text">
      Não encontramos o que você procurava — mas o cardápio continua quentinho. 💛
    </p>
    <a class="cd-404__btn" href="/">Voltar ao Cardápio</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-404 {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(48px, 12vh, 110px) clamp(20px, 6vw, 32px) 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Medalhao: logo da loja (SITE_LOGO), recortado em circulo. Ver docs/LOGO.md. */
  .cd-404__ring {
    width: 112px;
    height: 112px;
    border-radius: var(--radius-round);
    border: 2px solid var(--gold);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
    box-shadow: var(--shadow-seal);
  }
  .cd-404__ring-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-round);
  }
  /* ---- ANTES: monograma de texto no lugar do logo (substituido pela imagem).
     Markup antigo: <div class="cd-404__ring-inner">Nome<br />da Loja</div>
  .cd-404__ring-inner {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-round);
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-size: 13px;
    color: var(--ink);
    line-height: 1.3;
  }
  */
  .cd-404__code {
    font-family: var(--font-head);
    font-size: 15px;
    letter-spacing: 6px;
    color: var(--gold-text);
  }
  .cd-404__title {
    margin: 10px 0 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(24px, 6vw, 34px);
    line-height: 1.2;
    color: var(--ink);
  }
  .cd-404__text {
    margin: 14px 0 30px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted-text);
    max-width: 40ch;
  }
  .cd-404__btn {
    padding: 15px 30px;
    background: var(--brand);
    color: var(--cream);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .cd-404__btn:hover {
      color: var(--cream);
      background: var(--brand-hover);
    }
  }
  .cd-404__btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
</style>
