---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { SITE_NAME } from '../config/site';

// Pagina "Sobre" (estatica). O texto abaixo e GENERICO DE PROPOSITO — o dono
// da loja troca por um texto proprio. O nome vem de SITE_NAME
// (src/config/site.ts); se o nome pedir artigo masculino, troque "a" por "o"
// no titulo e no primeiro paragrafo. Passo a passo de como editar em
// docs/PAGINAS-INSTITUCIONAIS.md.
---

<BaseLayout
  title={`Sobre · ${SITE_NAME}`}
  description={`Conheça um pouco da história por trás da ${SITE_NAME}.`}
>
  <Header />

  <main class="cd-sobre">
    <div class="cd-sobre__rule"></div>
    <span class="cd-sobre__eyebrow">Nossa história</span>
    <h1 class="cd-sobre__title">Sobre a {SITE_NAME}</h1>

    <div class="cd-sobre__body">
      <p>
        A {SITE_NAME} nasceu do carinho pela cozinha e da vontade de
        compartilhar doces feitos com ingredientes de qualidade e muito
        capricho. Cada brownie, brigadeiro, bolo de pote e cookie é preparado
        artesanalmente, em pequenas quantidades, para garantir sabor e
        frescor em cada mordida.
      </p>
      <p>
        Aqui, cada receita carrega um pouco de dedicação, da escolha dos
        ingredientes até a entrega na sua casa. O cardápio muda com
        frequência, sempre trazendo novidades para adoçar o seu dia.
      </p>
      <p>
        Obrigada por fazer parte dessa história! Qualquer dúvida, é só
        chamar no <a href="/contato">Contato</a>. 💛
      </p>
    </div>

    <a class="cd-sobre__btn" href="/">Ver Cardápio</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-sobre {
    max-width: 620px;
    margin: 0 auto;
    padding: clamp(40px, 10vh, 90px) clamp(20px, 6vw, 32px) 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cd-sobre__rule {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 18px;
  }
  .cd-sobre__eyebrow {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cd-sobre__title {
    margin: 10px 0 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(26px, 6vw, 36px);
    line-height: 1.2;
    color: var(--ink);
  }
  .cd-sobre__body {
    margin-top: 26px;
    text-align: left;
  }
  .cd-sobre__body p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted-text);
    margin: 0 0 18px;
  }
  .cd-sobre__body p:last-child {
    margin-bottom: 0;
  }
  .cd-sobre__body a {
    color: var(--gold-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cd-sobre__btn {
    margin-top: 34px;
    padding: 15px 30px;
    background: var(--brand);
    color: var(--cream);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .cd-sobre__btn:hover {
      color: var(--cream);
      background: var(--brand-hover);
    }
  }
  .cd-sobre__btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
</style>
