---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import PageHero from '../components/PageHero.astro';
import { SITE_NAME } from '../config/site';
import { getSobrePagina } from '../data/paginas';
import { paragrafos } from '../content/paginas-schema';

// Pagina "Sobre". O conteudo (foto opcional, texto em tom pessoal e o texto
// do botao para o cardapio) e editado no CMS em Configuracoes -> Pagina
// Sobre (src/content/configuracoes/sobre.json). O que estiver vazio nao
// aparece. O titulo usa SITE_NAME (src/config/site.ts); se o nome pedir
// artigo masculino, troque "a" por "o" no titulo abaixo.
// Passo a passo em docs/PAGINAS-INSTITUCIONAIS.md.
//
// ---- ANTES: o texto era fixo aqui no codigo (tres paragrafos genericos com
//      SITE_NAME). Agora vem do CMS; o texto de exemplo esta no sobre.json.
const sobre = await getSobrePagina();
const textos = paragrafos(sobre.texto);
const chamada = sobre.chamada ?? 'Ver Cardápio';
---

<BaseLayout
  title={`Sobre · ${SITE_NAME}`}
  description={`Conheça um pouco da história por trás da ${SITE_NAME}.`}
>
  <Header />

  <PageHero eyebrow="Nossa história" title={`Sobre a ${SITE_NAME}`} />

  <main class="cd-page cd-sobre">
    {
      (sobre.foto || textos.length > 0) && (
        <article class="cd-page__card cd-sobre__card">
          {sobre.foto && (
            <img
              class="cd-sobre__foto"
              src={sobre.foto}
              alt={`Foto da ${SITE_NAME}`}
              width="1200"
              height="900"
              loading="eager"
              decoding="async"
            />
          )}
          {textos.length > 0 && (
            <div class="cd-sobre__body">
              {textos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          )}
        </article>
      )
    }

    <a class="cd-btn cd-btn--cta" href="/">{chamada}</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-sobre__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cd-sobre__foto {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-img);
    background: var(--sf-high);
  }
  .cd-sobre__body p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.7;
  }
  .cd-sobre__body p:last-child {
    margin-bottom: 0;
  }

  /* desktop: foto e texto lado a lado, numa coluna um pouco mais larga */
  @media (min-width: 768px) {
    .cd-sobre {
      max-width: 960px;
    }
    .cd-sobre__card:has(.cd-sobre__foto) {
      flex-direction: row;
      align-items: flex-start;
      gap: 28px;
    }
    .cd-sobre__foto {
      flex: 0 0 44%;
      /* sem isto, o minimo automatico do flex e a largura intrinseca da
         imagem (1200px) e a foto espreme o texto */
      min-width: 0;
    }
  }
</style>
