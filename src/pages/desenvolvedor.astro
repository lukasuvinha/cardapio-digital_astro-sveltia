---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ContactButton from '../components/ContactButton.astro';
import PageHero from '../components/PageHero.astro';
import { DEV_NAME, DEV_GITHUB_URL, DEV_LINKEDIN_URL, SITE_NAME } from '../config/site';

// Pagina "Desenvolvedor" (estatica), alcancada por um link discreto no fim
// da pagina de Contato (/contato). Como trocar nome/links: ver
// docs/PAGINAS-INSTITUCIONAIS.md.
---

<BaseLayout
  title={`Desenvolvedor · ${SITE_NAME}`}
  description={`Quem desenvolveu o cardápio digital da ${SITE_NAME}.`}
>
  <Header />

  <PageHero eyebrow="Desenvolvimento" title={DEV_NAME} subtitle="Criação e desenvolvimento deste cardápio digital." />

  <main class="cd-page cd-dev">
    <span class="cd-dev__badge" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6 3 12l5 6M16 6l5 6-5 6" /></svg>
    </span>
    <div class="cd-dev__links">
      <ContactButton href={DEV_GITHUB_URL} label="GitHub" icon="github" external />
      <ContactButton href={DEV_LINKEDIN_URL} label="LinkedIn" icon="linkedin" external />
    </div>

    <a class="cd-dev__back" href="/contato">‹ Voltar ao Contato</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .cd-dev__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--r-icon);
    background: var(--s-c);
    color: var(--on-s-c);
  }
  .cd-dev__links {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cd-dev__back {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 12px;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
  }
</style>
