---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ContactButton from '../components/ContactButton.astro';
import { DEV_NAME, DEV_GITHUB_URL, DEV_LINKEDIN_URL } from '../config/site';

// Pagina "Desenvolvedor" (estatica), alcancada por um link discreto no fim
// da pagina de Contato (/contato). Como trocar nome/links: ver
// docs/PAGINAS-INSTITUCIONAIS.md.
---

<BaseLayout
  title="Desenvolvedor · Doçuras da Nina"
  description="Quem desenvolveu o cardápio digital da Doçuras da Nina."
>
  <Header />

  <main class="dn-dev">
    <div class="dn-dev__ring">
      <div class="dn-dev__ring-inner" aria-hidden="true">‹/›</div>
    </div>
    <span class="dn-dev__eyebrow">Desenvolvimento</span>
    <h1 class="dn-dev__name">{DEV_NAME}</h1>
    <p class="dn-dev__text">Criação e desenvolvimento deste cardápio digital.</p>

    <div class="dn-dev__links">
      <ContactButton href={DEV_GITHUB_URL} label="GitHub" icon="github" external />
      <ContactButton href={DEV_LINKEDIN_URL} label="LinkedIn" icon="linkedin" external />
    </div>

    <a class="dn-dev__back" href="/contato">‹ Voltar ao Contato</a>
  </main>

  <Footer />

  <CartDrawer />
</BaseLayout>

<style>
  .dn-dev {
    max-width: 460px;
    margin: 0 auto;
    padding: clamp(40px, 10vh, 90px) clamp(20px, 6vw, 32px) 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .dn-dev__ring {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }
  .dn-dev__ring-inner {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-size: 18px;
    color: var(--ink);
  }
  .dn-dev__eyebrow {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dn-dev__name {
    margin: 10px 0 0;
    font-family: var(--font-head);
    font-weight: 400;
    font-size: clamp(24px, 6vw, 32px);
    line-height: 1.2;
    color: var(--ink);
  }
  .dn-dev__text {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--muted-text);
  }
  .dn-dev__links {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }
  .dn-dev__back {
    margin-top: 38px;
    font-size: 12.5px;
    letter-spacing: 1px;
    color: var(--muted);
  }
  @media (hover: hover) {
    .dn-dev__back:hover {
      color: var(--ink);
    }
  }
</style>
