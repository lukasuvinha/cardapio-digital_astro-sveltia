---
// Chips de filtro por categoria (Material 3 "filter chips"), em linha com
// rolagem horizontal. "Todos" vem primeiro e selecionado.
// Nao selecionado: fundo na cor da categoria, sem borda. Selecionado:
// --inv-sf, raio maior e um "check" que entra animado a esquerda.
// O comportamento (filtrar a grade) fica no script da pagina, que escuta
// cliques nos botoes [data-filter] e mostra/esconde os cards por
// [data-categoria]. Sem recarregar a pagina.
import type { CorCategoria } from '../data/menu-helpers';

interface Item {
  label: string;
  slug: string;
  cor: CorCategoria;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="cd-chips" role="toolbar" aria-label="Filtrar por categoria">
  {
    [{ label: 'Todos', slug: 'all', cor: 'neutro' as CorCategoria }, ...items].map((item, i) => (
      <button
        class="cd-chip cd-state"
        type="button"
        data-filter={item.slug}
        data-cor={item.cor}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        <span class="cd-chip__check" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <span>{item.label}</span>
      </button>
    ))
  }
</div>

<style>
  .cd-chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 16px 8px;
    margin: 0 -16px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-padding: 0 16px;
  }
  .cd-chips::-webkit-scrollbar {
    display: none;
  }

  .cd-chip {
    /* nunca encolhe nem corta o texto: a linha rola na horizontal */
    flex: none;
    display: inline-flex;
    align-items: center;
    height: var(--touch);
    padding: 0 18px;
    border-radius: var(--r-field);
    background: var(--cat);
    color: var(--on-sf);
    font-size: 14px;
    font-weight: var(--fw-label);
    white-space: nowrap;
    transition:
      background-color var(--dur-emph) var(--ease-emph),
      color var(--dur-emph) var(--ease-emph),
      border-radius var(--dur-emph) var(--ease-emph),
      padding var(--dur-emph) var(--ease-emph);
  }
  .cd-chip__check {
    display: inline-flex;
    width: 0;
    opacity: 0;
    transform: scale(0.4);
    overflow: hidden;
    transition:
      width var(--dur-emph) var(--ease-emph),
      opacity var(--dur-emph) var(--ease-emph),
      transform var(--dur-spring) var(--ease-spring),
      margin var(--dur-emph) var(--ease-emph);
  }
  .cd-chip[aria-pressed='true'] {
    background: var(--inv-sf);
    color: var(--inv-on-sf);
    border-radius: var(--r-chip-on);
    padding-left: 12px;
  }
  .cd-chip[aria-pressed='true'] .cd-chip__check {
    width: 18px;
    margin-right: 6px;
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 768px) {
    .cd-chips {
      flex-wrap: wrap;
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }
</style>
