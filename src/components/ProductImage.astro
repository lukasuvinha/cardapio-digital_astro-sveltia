---
// Componente de imagem de produto reutilizavel.
//
// A foto e uma URL de /public (ex.: /uploads/foo.webp), renderizada com <img>
// simples. O build NAO processa a imagem, entao um upload ruim NUNCA quebra o
// build/deploy (ao contrario do image()/<Picture> do Astro, que hard-failava).
// A otimizacao (WebP + resize) acontece no UPLOAD, pelo proprio Sveltia CMS
// (ver public/admin/config.yml -> media_libraries.transformations).
//
// PROTECOES contra foto incompativel:
//  - o placeholder fica SEMPRE atras da imagem; se a foto nao existir, tiver
//    formato nao suportado (productHasPhoto=false) ou falhar ao carregar
//    (onerror), o placeholder aparece — nunca uma imagem quebrada.
//
// TAMANHO/RECOMENDACAO das fotos (o CMS ja cuida disso no upload):
//   - Proporcao 4:3 (ex.: 1200 x 900). No card a foto e QUADRADA (recorte
//     central via object-fit); deixe o doce no centro da foto.
//   - Formato: JPG, PNG ou WebP (o CMS converte para WebP e redimensiona).
import { productHasPhoto } from '../data/menu-helpers';

interface Props {
  foto?: string;
  alt: string;
  /** 'eager' para imagens acima da dobra (ex.: detalhe); 'lazy' no restante */
  loading?: 'lazy' | 'eager';
  /** classe extra aplicada ao container (para borda/arredondamento etc.) */
  class?: string;
}

const { foto, alt, loading = 'lazy', class: className } = Astro.props;
const temFoto = productHasPhoto({ foto });
---

<div
  class:list={['cd-media', className]}
  data-photo={temFoto ? 'image' : 'placeholder'}
>
  {/* placeholder SEMPRE presente como base; a imagem (se houver) cobre ele */}
  <div class="cd-media__ph" aria-hidden="true">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <circle cx="9" cy="11" r="2" />
      <path d="M3 17l5-4 4 3 3-2 6 5" />
    </svg>
    <span>Foto em breve</span>
  </div>

  {
    temFoto && (
      <img
        class="cd-media__img"
        src={foto}
        alt={alt}
        loading={loading}
        decoding="async"
        onerror="this.remove()"
      />
    )
  }

  <slot />
</div>

<style>
  /* Proporcao: 4:3 por padrao. Quem usa pode trocar com a variavel
     --media-ratio (ex.: o card usa 1 / 1) e arredondar via classe propria. */
  .cd-media {
    position: relative;
    aspect-ratio: var(--media-ratio, 4 / 3);
    background: var(--sf-high);
    overflow: hidden;
  }
  /* a imagem vem depois do placeholder no DOM, entao pinta por cima dele;
     o conteudo do <slot> (ex.: selo "Esgotado") vem depois e fica acima da img */
  .cd-media__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cd-media__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--on-sf-v);
  }
  .cd-media__ph span {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
  }
</style>
