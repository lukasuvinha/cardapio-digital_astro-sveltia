---
// Icones de traco usados nos botoes de contato (ContactButton) e no rodape.
// Sao desenhos genericos no mesmo estilo de linha fina do resto do site — de
// proposito NAO sao os logos oficiais das marcas; o rotulo (ou o aria-label)
// ao lado deixa claro para onde o link leva. Decorativos: sempre dentro de um
// elemento com aria-hidden ou com nome acessivel proprio.
interface Props {
  icon: 'whatsapp' | 'instagram' | 'github' | 'linkedin';
  size?: number;
}
const { icon, size = 20 } = Astro.props;
---

  {icon === 'whatsapp' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
  )}
  {icon === 'instagram' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </svg>
  )}
  {icon === 'github' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="8 6 3 12 8 18" />
      <polyline points="16 6 21 12 16 18" />
    </svg>
  )}
  {icon === 'linkedin' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <line x1="8" y1="17" x2="8" y2="10.5" />
      <circle cx="8" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
      <path d="M12 17v-4.2c0-1.5 1-2.3 2.2-2.3S16 11.3 16 12.8V17" />
    </svg>
  )}
