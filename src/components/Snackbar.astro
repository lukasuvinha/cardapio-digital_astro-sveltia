---
// Snackbar (Material 3): aviso curto no rodape — ex.: "Brownie adicionado"
// com a acao "Ver" (abre o carrinho). Some sozinho em ~2,5s. Controlado por
// showSnackbar() em src/lib/snackbar.ts. Fica no trilho sticky do
// CartRail.astro (logo antes do rodape), entao acompanha o FAB sem script e
// existe em toda pagina que tem rodape/carrinho.
---

<div class="cd-snack" data-snackbar data-show="false" role="status" aria-live="polite" hidden>
  <span class="cd-snack__text" data-snack-text></span>
  <button class="cd-snack__action cd-state" type="button" data-snack-action hidden></button>
</div>

<style>
  /* Posicionado dentro do trilho sticky (CartRail.astro), que fica no fundo
     da janela — ou na borda de cima do rodape, quando ele aparece. */
  .cd-snack {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 4px 4px 4px 16px;
    border-radius: var(--r-field);
    background: var(--inv-sf);
    color: var(--inv-on-sf);
    box-shadow: var(--elev-3);
    opacity: 0;
    transform: translateY(calc(16px * var(--motion-shift)));
    pointer-events: none;
    transition:
      opacity var(--dur-out) var(--ease-out),
      transform var(--dur-out) var(--ease-out),
      bottom var(--dur-emph) var(--ease-emph);
  }
  /* ---- ANTES (PR #4): position: fixed; bottom: calc(16px +
     env(safe-area-inset-bottom)); e, com o FAB, translate: 0 calc(-1 *
     var(--fab-lift, 0px)). Agora a area segura e o rodape sao resolvidos
     pelo trilho sticky. */
  .cd-snack[data-show='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--dur-in) var(--ease-in),
      transform var(--dur-in) var(--ease-in),
      bottom var(--dur-emph) var(--ease-emph);
  }
  /* no celular, fica acima do botao flutuante do carrinho (16 + 60 + 16) */
  :global(body.cd-has-fab) .cd-snack {
    bottom: 92px;
  }
  .cd-snack__text {
    flex: 1;
    font-size: 14px;
  }
  .cd-snack__action {
    flex: none;
    min-height: var(--touch);
    padding: 0 16px;
    border-radius: var(--r-pill);
    color: var(--inv-on-sf);
    font-weight: var(--fw-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .cd-snack {
      left: 50%;
      right: auto;
      width: max-content;
      min-width: 320px;
      max-width: 560px;
      translate: -50% 0;
      bottom: 24px;
    }
    :global(body.cd-has-fab) .cd-snack {
      bottom: 24px;
    }
  }
</style>
