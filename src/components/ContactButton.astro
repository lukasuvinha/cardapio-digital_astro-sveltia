---
// Botao grande de contato/link externo (estilo "linktree"): icone + rotulo +
// seta. Reutilizado nas paginas Contato (WhatsApp, Instagram) e Desenvolvedor
// (GitHub, LinkedIn). Os icones sao desenhos genericos no mesmo estilo de
// linha fina (stroke) usado no resto do site — nao sao os logos oficiais das
// marcas, so representacoes reconheciveis; o rotulo ao lado deixa claro para
// onde o link leva.
interface Props {
  href: string;
  label: string;
  icon: 'whatsapp' | 'instagram' | 'github' | 'linkedin';
  /** true para links externos (abre em nova aba, rel=noopener) */
  external?: boolean;
}

const { href, label, icon, external = false } = Astro.props;
---

<a
  class="dn-linkbtn"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="dn-linkbtn__icon" aria-hidden="true">
    {icon === 'whatsapp' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
    )}
    {icon === 'instagram' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </svg>
    )}
    {icon === 'github' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="8 6 3 12 8 18" />
        <polyline points="16 6 21 12 16 18" />
      </svg>
    )}
    {icon === 'linkedin' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <line x1="8" y1="17" x2="8" y2="10.5" />
        <circle cx="8" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
        <path d="M12 17v-4.2c0-1.5 1-2.3 2.2-2.3S16 11.3 16 12.8V17" />
      </svg>
    )}
  </span>
  <span class="dn-linkbtn__label">{label}</span>
  <span class="dn-linkbtn__arrow" aria-hidden="true">›</span>
</a>

<style>
  .dn-linkbtn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  @media (hover: hover) {
    .dn-linkbtn:hover {
      color: var(--ink);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(31, 77, 58, 0.14);
      border-color: var(--gold);
    }
  }
  .dn-linkbtn__icon {
    flex: none;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--card-alt);
    color: var(--brand);
  }
  :global(:root[data-theme='dark']) .dn-linkbtn__icon {
    color: var(--cream);
  }
  .dn-linkbtn__label {
    flex: 1;
    font-family: var(--font-head);
    font-size: 16px;
    color: var(--ink);
  }
  .dn-linkbtn__arrow {
    flex: none;
    font-size: 20px;
    line-height: 1;
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  @media (hover: hover) {
    .dn-linkbtn:hover .dn-linkbtn__arrow {
      color: var(--ink);
      transform: translateX(2px);
    }
  }
</style>
