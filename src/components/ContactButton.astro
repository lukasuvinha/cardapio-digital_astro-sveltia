---
// Botao grande de contato/link externo (estilo "linktree"): icone + rotulo +
// seta. Reutilizado nas paginas Contato (WhatsApp, Instagram) e Desenvolvedor
// (GitHub, LinkedIn). Os icones sao desenhos genericos no mesmo estilo de
// linha fina (stroke) usado no resto do site — nao sao os logos oficiais das
// marcas, so representacoes reconheciveis; o rotulo ao lado deixa claro para
// onde o link leva.
interface Props {
  href: string;
  label: string;
  icon: 'whatsapp' | 'instagram' | 'github' | 'linkedin';
  /** true para links externos (abre em nova aba, rel=noopener) */
  external?: boolean;
}

import SocialIcon from './SocialIcon.astro';

const { href, label, icon, external = false } = Astro.props;
---

<a
  class="cd-linkbtn cd-state"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cd-linkbtn__icon" aria-hidden="true">
    <SocialIcon icon={icon} />
  </span>
  <span class="cd-linkbtn__label">{label}</span>
  <span class="cd-linkbtn__arrow" aria-hidden="true">›</span>
</a>

<style>
  .cd-linkbtn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 72px;
    padding: 12px 18px 12px 12px;
    border-radius: var(--r-card);
    background: var(--sf-low);
    color: var(--on-sf);
    text-decoration: none;
    transition:
      transform var(--dur-emph) var(--ease-emph),
      box-shadow var(--dur-emph) var(--ease-emph);
  }
  .cd-linkbtn:hover {
    text-decoration: none;
  }
  @media (hover: hover) {
    .cd-linkbtn:hover {
      transform: translateY(calc(-2px * var(--motion-shift)));
      box-shadow: var(--elev-2);
    }
  }
  .cd-linkbtn__icon {
    flex: none;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-icon);
    background: var(--s-c);
    color: var(--on-s-c);
  }
  .cd-linkbtn__label {
    flex: 1;
    font-family: var(--font-head);
    font-weight: var(--fw-head);
    font-size: 17px;
  }
  .cd-linkbtn__arrow {
    flex: none;
    font-size: 24px;
    line-height: 1;
    color: var(--on-sf-v);
    transition: transform var(--dur-emph) var(--ease-emph);
  }
  @media (hover: hover) {
    .cd-linkbtn:hover .cd-linkbtn__arrow {
      transform: translateX(calc(3px * var(--motion-shift)));
    }
  }
</style>
