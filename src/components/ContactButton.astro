---
// Botao grande de contato/link externo (estilo "linktree"): icone + rotulo +
// seta. Reutilizado nas paginas Contato (WhatsApp, Instagram) e Desenvolvedor
// (GitHub, LinkedIn). Os icones sao desenhos genericos no mesmo estilo de
// linha fina (stroke) usado no resto do site — nao sao os logos oficiais das
// marcas, so representacoes reconheciveis; o rotulo ao lado deixa claro para
// onde o link leva.
interface Props {
  href: string;
  label: string;
  icon: 'whatsapp' | 'instagram' | 'github' | 'linkedin';
  /** true para links externos (abre em nova aba, rel=noopener) */
  external?: boolean;
}

const { href, label, icon, external = false } = Astro.props;
---

<a
  class="cd-linkbtn cd-state"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cd-linkbtn__icon" aria-hidden="true">
    {icon === 'whatsapp' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
    )}
    {icon === 'instagram' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
        <circle cx="12" cy="12" r="4.2" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </svg>
    )}
    {icon === 'github' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="8 6 3 12 8 18" />
        <polyline points="16 6 21 12 16 18" />
      </svg>
    )}
    {icon === 'linkedin' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <line x1="8" y1="17" x2="8" y2="10.5" />
        <circle cx="8" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
        <path d="M12 17v-4.2c0-1.5 1-2.3 2.2-2.3S16 11.3 16 12.8V17" />
      </svg>
    )}
  </span>
  <span class="cd-linkbtn__label">{label}</span>
  <span class="cd-linkbtn__arrow" aria-hidden="true">›</span>
</a>

<style>
  .cd-linkbtn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 72px;
    padding: 12px 18px 12px 12px;
    border-radius: var(--r-card);
    background: var(--sf-low);
    color: var(--on-sf);
    text-decoration: none;
    transition:
      transform var(--dur-emph) var(--ease-emph),
      box-shadow var(--dur-emph) var(--ease-emph);
  }
  .cd-linkbtn:hover {
    text-decoration: none;
  }
  @media (hover: hover) {
    .cd-linkbtn:hover {
      transform: translateY(calc(-2px * var(--motion-shift)));
      box-shadow: var(--elev-2);
    }
  }
  .cd-linkbtn__icon {
    flex: none;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-icon);
    background: var(--s-c);
    color: var(--on-s-c);
  }
  .cd-linkbtn__label {
    flex: 1;
    font-family: var(--font-head);
    font-weight: var(--fw-head);
    font-size: 17px;
  }
  .cd-linkbtn__arrow {
    flex: none;
    font-size: 24px;
    line-height: 1;
    color: var(--on-sf-v);
    transition: transform var(--dur-emph) var(--ease-emph);
  }
  @media (hover: hover) {
    .cd-linkbtn:hover .cd-linkbtn__arrow {
      transform: translateX(calc(3px * var(--motion-shift)));
    }
  }
</style>
