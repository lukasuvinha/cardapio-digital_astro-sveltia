---
// Grade de produtos: 2 colunas no celular; no desktop, colunas automaticas
// de no minimo 220px. Os cards entram em cascata (ver ProductCard).
import type { Product, CorCategoria } from '../data/menu';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  /** cor de cada categoria (nome -> cor); sem mapa, os cards ficam neutros */
  cores?: Record<string, CorCategoria>;
}

const { products, cores = {} } = Astro.props;
---

{
  products.length > 0 ? (
    <div class="cd-grid">
      {products.map((product, i) => (
        <ProductCard product={product} cor={cores[product.categoria]} index={i} />
      ))}
    </div>
  ) : (
    /* Estado vazio: cardapio sem produtos (ex.: CMS ainda sem cadastro).
       O site e estatico, entao continua no ar normalmente com esta mensagem. */
    <div class="cd-grid-empty">
      <div class="cd-grid-empty__title">Cardápio em atualização</div>
      <p class="cd-grid-empty__text">
        Estamos preparando novas delícias. Volte em breve para conferir! 💛
      </p>
    </div>
  )
}

<style>
  .cd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .cd-grid-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 12vh, 90px) 24px;
    border-radius: var(--r-card);
    background: var(--sf-low);
  }
  .cd-grid-empty__title {
    font-family: var(--font-head);
    font-weight: var(--fw-head);
    font-size: 24px;
  }
  .cd-grid-empty__text {
    margin: 8px 0 0;
    color: var(--on-sf-v);
    max-width: 34ch;
  }

  @media (min-width: 768px) {
    .cd-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
  }
</style>
