---
import type { Product } from '../data/menu';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

{
  products.length > 0 ? (
    <div class="dn-grid">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  ) : (
    /* Estado vazio: cardapio sem produtos (ex.: CMS ainda sem cadastro).
       O site e estatico, entao continua no ar normalmente com esta mensagem. */
    <div class="dn-grid-empty">
      <div class="dn-grid-empty__rule" />
      <div class="dn-grid-empty__title">Cardápio em atualização</div>
      <p class="dn-grid-empty__text">
        Estamos preparando novas doçuras. Volte em breve para conferir! 💛
      </p>
    </div>
  )
}

<style>
  /* Mobile-first: 2 colunas no celular. */
  .dn-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  /* Estado vazio (sem produtos) — mesma linguagem visual retro do restante. */
  .dn-grid-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(40px, 12vh, 90px) 24px;
  }
  .dn-grid-empty__rule {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 18px;
  }
  .dn-grid-empty__title {
    font-family: var(--font-head);
    font-size: clamp(20px, 5vw, 26px);
    color: var(--ink);
  }
  .dn-grid-empty__text {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted-text);
    max-width: 34ch;
  }

  /* Tablet+: colunas automaticas com largura minima, para preencher a tela
     sem deixar grande espaco vazio a direita e sem esticar demais os cards
     quando um filtro deixa poucos itens. Com o max-width do container isso
     resulta em ~4 colunas no desktop. */
  @media (min-width: 600px) {
    .dn-grid {
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 24px;
    }
  }
</style>
