---
// Card de produto (Material 3, mobile-first).
// Fundo na cor da categoria (--cat, via data-cor); foto quadrada; categoria,
// nome (ate 2 linhas) e preco. O card inteiro e um link para
// /produto/:id — sem JS ele navega para a pagina estatica; com JS, no
// cardapio, o clique abre o detalhe numa sheet/dialog (ver ProductSheet.astro).
//
// Botao "+" (canto inferior direito): adiciona 1 unidade ao carrinho. Quando
// o produto ja esta no carrinho vira um circulo ambar com a quantidade
// (atualizado pelo script do CartDrawer via [data-add-to-cart]). Produto
// esgotado: foto em cinza, selo "Esgotado" e sem botao "+".
//
// O botao fica FORA do <a> (botao dentro de link e HTML invalido); o link
// cobre o card todo com um pseudo-elemento e o botao fica por cima.
import type { Product, CorCategoria } from '../data/menu';
import { formatPrice } from '../lib/format';
import { slugify } from '../lib/slug';
import ProductImage from './ProductImage.astro';

interface Props {
  product: Product;
  cor?: CorCategoria;
  /** posicao na grade, para a entrada em cascata */
  index?: number;
}

const { product, cor = 'neutro', index = 0 } = Astro.props;
const catSlug = slugify(product.categoria);
---

<article
  class="cd-card"
  data-testid="product-card"
  data-categoria={catSlug}
  data-available={String(product.disponivel)}
  data-cor={cor}
  style={`--i: ${index}`}
>
  <a class="cd-card__link cd-state" href={`/produto/${product.id}`} data-open-detail={product.id}>
    <div class="cd-card__media">
      <ProductImage foto={product.foto} alt={`Foto de ${product.nome}`}>
        {!product.disponivel && <span class="cd-card__soldout">Esgotado</span>}
      </ProductImage>
    </div>
    <span class="cd-card__cat">{product.categoria}</span>
    <h3 class="cd-card__name">{product.nome}</h3>
    <span class="cd-card__price">{formatPrice(product.preco)}</span>
  </a>

  {
    product.disponivel && (
      <button
        class="cd-card__add cd-state"
        type="button"
        data-add-to-cart={product.id}
        data-nome={product.nome}
        aria-label={`Adicionar ${product.nome} ao carrinho`}
      >
        <svg class="cd-card__plus" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="cd-card__qty" data-qty-label aria-hidden="true"></span>
      </button>
    )
  }
</article>

<style>
  .cd-card {
    position: relative;
    border-radius: var(--r-card);
    background: var(--cat);
    color: var(--on-sf);
    transition:
      transform var(--dur-emph) var(--ease-emph),
      box-shadow var(--dur-emph) var(--ease-emph),
      background-color var(--dur-emph) var(--ease-emph);
    animation: cd-card-in var(--dur-in) var(--ease-in) backwards;
    animation-delay: calc(var(--i, 0) * var(--stagger));
  }
  /* usado pelo filtro de categorias */
  .cd-card[hidden] {
    display: none;
  }
  @keyframes cd-card-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cd-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px 8px 14px;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }
  .cd-card__link:hover {
    text-decoration: none;
  }

  .cd-card__media {
    --media-ratio: 1 / 1;
    border-radius: var(--r-img);
    overflow: hidden;
    /* garante o recorte arredondado durante o zoom (Safari) */
    isolation: isolate;
  }
  .cd-card__media :global(.cd-media__img) {
    transition: transform var(--dur-in) var(--ease-emph), filter var(--dur-emph) var(--ease-emph);
  }
  .cd-card__soldout {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: var(--r-badge);
    background: var(--inv-sf);
    color: var(--inv-on-sf);
    font-size: 12px;
    font-weight: var(--fw-strong);
    z-index: 1;
  }
  .cd-card[data-available='false'] .cd-card__media :global(.cd-media__img) {
    filter: grayscale(1);
  }

  .cd-card__cat {
    margin: 12px 6px 0;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    color: var(--on-sf-v);
  }
  .cd-card__name {
    margin: 2px 6px 0;
    font-size: 16px;
    line-height: 1.3;
    /* ate 2 linhas */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
  }
  .cd-card__price {
    margin: 8px 56px 0 6px;
    font-family: var(--font-head);
    font-size: var(--fs-price);
    font-weight: var(--fw-strong);
    color: var(--primary);
    min-height: var(--touch);
    display: flex;
    align-items: center;
  }

  /* Botao "+" (acao = --cta) */
  .cd-card__add {
    position: absolute;
    right: 10px;
    bottom: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: var(--r-round);
    background: var(--cta);
    color: var(--on-cta);
    box-shadow: var(--shadow-cta), var(--shine);
    transition:
      transform var(--dur-spring) var(--ease-spring),
      background-color var(--dur-emph) var(--ease-emph),
      color var(--dur-emph) var(--ease-emph),
      box-shadow var(--dur-emph) var(--ease-emph);
  }
  .cd-card__add:active {
    transform: scale(0.95);
  }
  .cd-card__qty {
    display: none;
    font-family: var(--font-head);
    font-size: 17px;
    font-weight: var(--fw-strong);
  }
  /* ja no carrinho: circulo ambar (destaque) com a quantidade */
  .cd-card__add[data-in-cart='true'] {
    background: var(--hl);
    color: var(--on-hl);
    box-shadow: var(--shine);
  }
  .cd-card__add[data-in-cart='true'] .cd-card__plus {
    display: none;
  }
  .cd-card__add[data-in-cart='true'] .cd-card__qty {
    display: inline;
  }
  .cd-card__add.is-bump {
    animation: cd-bump var(--dur-spring) var(--ease-spring);
  }

  @media (hover: hover) {
    .cd-card:hover {
      transform: translateY(calc(-4px * var(--motion-shift)));
      box-shadow: var(--elev-2);
    }
    .cd-card:hover .cd-card__media :global(.cd-media__img) {
      transform: scale(calc(1 + 0.05 * var(--motion-shift)));
    }
  }

  @media (min-width: 768px) {
    .cd-card__price {
      font-size: var(--fs-price-lg);
    }
  }
</style>
