---
// Rodape reutilizavel: usado em todas as paginas (home, detalhe de produto,
// 404, sobre, contato, desenvolvedor). Alem da marca, traz links para as
// paginas institucionais "Sobre" e "Contato" (no desktop eles tambem ficam
// na barra superior).
import { SITE_NAME, SITE_TAGLINE } from '../config/site';
import CartRail from './CartRail.astro';
---

<!-- trilhos sticky do botao flutuante do carrinho e do snackbar: precisam
     ficar LOGO ANTES do rodape para pararem acima dele (ver CartRail.astro) -->
<CartRail />

<footer class="cd-footer">
  <span class="cd-footer__brand">{SITE_NAME} · {SITE_TAGLINE}</span>
  <nav class="cd-footer__links" aria-label="Links institucionais">
    <a href="/sobre">Sobre</a>
    <span class="cd-footer__dot" aria-hidden="true">·</span>
    <a href="/contato">Contato</a>
  </nav>
</footer>

<style>
  .cd-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 28px 16px calc(28px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--ol-v);
    text-align: center;
    color: var(--on-sf-v);
  }
  .cd-footer__brand {
    font-family: var(--font-head);
    font-weight: var(--fw-head);
    font-size: var(--fs-body);
    color: var(--on-sf);
  }
  .cd-footer__links {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }
  .cd-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 8px;
    color: var(--on-sf-v);
    font-weight: var(--fw-label);
  }
  .cd-footer__links a:hover {
    color: var(--primary);
  }
</style>
