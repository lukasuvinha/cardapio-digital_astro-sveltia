---
// Rodape reutilizavel: usado em todas as paginas (home, detalhe de produto,
// 404, sobre, contato, desenvolvedor). Alem da marca, traz links discretos
// para as paginas institucionais "Sobre" e "Contato".
---

<footer class="dn-footer">
  <span class="dn-footer__brand">Doçuras da Nina · Doceria Artesanal</span>
  <nav class="dn-footer__links" aria-label="Links institucionais">
    <a href="/sobre">Sobre</a>
    <span class="dn-footer__dot" aria-hidden="true">·</span>
    <a href="/contato">Contato</a>
  </nav>
</footer>

<style>
  .dn-footer {
    border-top: 1px solid var(--border);
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .dn-footer__brand {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dn-footer__links {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.6px;
  }
  .dn-footer__links a {
    color: var(--muted-text);
  }
  @media (hover: hover) {
    .dn-footer__links a:hover {
      color: var(--ink);
    }
  }
  .dn-footer__dot {
    color: var(--border);
  }
</style>
