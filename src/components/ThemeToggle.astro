---
// Botao reutilizavel de alternancia de tema (claro/escuro).
// Uso: <ThemeToggle /> em qualquer lugar. Pode haver mais de um na pagina;
// o script sincroniza todos. A escolha e persistida em localStorage ('cd-theme')
// e aplicada antes da pintura pelo script inline do BaseLayout (sem flash).
// O icone (sol/lua) gira ao trocar.
---

<button
  class="cd-theme-toggle cd-state"
  type="button"
  aria-label="Alternar tema claro e escuro"
>
  <span class="cd-theme-toggle__spin" aria-hidden="true">
    <!-- Sol: exibido no tema ESCURO (clicar volta para o claro) -->
    <svg class="icon icon-sun" width="22" height="22" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="12" y1="2" x2="12" y2="4.2"></line>
        <line x1="12" y1="19.8" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="4.2" y2="12"></line>
        <line x1="19.8" y1="12" x2="22" y2="12"></line>
        <line x1="4.9" y1="4.9" x2="6.5" y2="6.5"></line>
        <line x1="17.5" y1="17.5" x2="19.1" y2="19.1"></line>
        <line x1="4.9" y1="19.1" x2="6.5" y2="17.5"></line>
        <line x1="17.5" y1="6.5" x2="19.1" y2="4.9"></line>
      </g>
    </svg>
    <!-- Lua: exibida no tema CLARO (clicar vai para o escuro) -->
    <svg class="icon icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 1 0 10.5 10.5Z" fill="currentColor"></path>
    </svg>
  </span>
</button>

<style>
  .cd-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: var(--r-round);
    color: var(--on-hero);
  }
  .cd-theme-toggle__spin {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
    transition: transform var(--dur-spring) var(--ease-spring);
  }
  .cd-theme-toggle .icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: opacity var(--dur-emph) var(--ease-emph);
  }

  /* Claro: mostra a lua. Escuro: mostra o sol e o conjunto gira meia volta. */
  .cd-theme-toggle .icon-sun {
    opacity: 0;
  }
  :global(:root[data-theme='dark']) .cd-theme-toggle__spin {
    transform: rotate(calc(180deg * var(--motion-shift)));
  }
  :global(:root[data-theme='dark']) .cd-theme-toggle .icon-sun {
    opacity: 1;
  }
  :global(:root[data-theme='dark']) .cd-theme-toggle .icon-moon {
    opacity: 0;
  }

  /* Fallback sem JS: acompanha a preferencia do sistema */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']):not([data-theme='dark'])) .cd-theme-toggle .icon-sun {
      opacity: 1;
    }
    :global(:root:not([data-theme='light']):not([data-theme='dark'])) .cd-theme-toggle .icon-moon {
      opacity: 0;
    }
  }
</style>

<script>
  function currentTheme(): 'dark' | 'light' {
    const attr = document.documentElement.getAttribute('data-theme');
    if (attr === 'dark' || attr === 'light') return attr;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: 'dark' | 'light') {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('cd-theme', theme);
    } catch (e) {
      /* localStorage indisponivel: mantem apenas na sessao atual */
    }
    document.querySelectorAll('.cd-theme-toggle').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(theme === 'dark'));
    });
    // a cor da barra do navegador acompanha a escolha manual
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      const cor = theme === 'dark' ? m.dataset.dark : m.dataset.light;
      if (cor) m.content = cor;
    });
  }

  document.querySelectorAll('.cd-theme-toggle').forEach((btn) => {
    btn.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
    btn.addEventListener('click', () => {
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
    });
  });
</script>
